// agentx — LIVE opencode configuration (authoritative).
// Coarse, declarative enforcement of the AGENTS.md "NEVER" rules. Fine-grained,
// teaching enforcement of the OMT++ process lives in .opencode/plugins/omt_enforcer.ts.
// Local plugins auto-load from .opencode/plugins/ — the `plugin` array is npm-only
// (official docs), so the omt_* plugins are deliberately NOT listed there.
{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,

  "agent": {
    "build": {
      "prompt": "{file:./.agents_prompts/build.md}"
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "primary",
      "model": "openrouter/openrouter/auto",
      "prompt": "{file:./.agents_prompts/code-reviewer.md}",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },

  // Last matching pattern wins. Defaults stay permissive for a solo dev; the
  // hard rules below are the ones AGENTS.md marks as NEVER.
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      // harnessc:begin read
        "*.env": "deny",
        "*.env.*": "deny"
      // harnessc:end read
    },
    "bash": {
      "*": "ask",
      "uv *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "grep *": "allow",
      // harnessc:begin bash
        "git commit *": "deny",
        "git push *": "deny",
        "python *": "deny",
        "python3 *": "deny",
        "pip *": "deny",
        "pip3 *": "deny",
        "pytest *": "deny"
      // harnessc:end bash
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    // harnessc:begin perm
      "webfetch": "deny",
      "omt_phase": "allow",
      "omt_skip": "allow",
      "omt_complete": "allow",
      "omt_status": "allow",
      "omt_testlist": "allow",
      "omt_red": "allow",
      "omt_green": "allow",
      "omt_refactor": "allow",
      "omt_done": "allow",
      "omt_nav": "allow",
      "omt_list_sections": "allow",
      "omt_cross_ref": "allow",
      "omt_quick_ref": "allow",
      "omt_think": "allow",
      "omt_think_list": "allow",
      "omt_think_remove": "allow",
      "omt_think_verify": "allow",
      "omt_think_suggest": "allow"
    // harnessc:end perm
  }
}
