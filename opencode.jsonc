// agentx — LIVE opencode configuration (authoritative).
// Coarse, declarative enforcement of the AGENTS.md "NEVER" rules. Fine-grained,
// teaching enforcement of the OMT++ process lives in .opencode/plugins/omt_enforcer.ts.
// Local plugins auto-load from .opencode/plugins/ — the `plugin` array is npm-only
// (official docs), so the omt_* plugins are deliberately NOT listed there.
{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,

  "agent": {
    "build": {
      "prompt": "{file:./.agents_prompts/build.md}"
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "primary",
      "model": "openrouter/openrouter/auto",
      "prompt": "{file:./.agents_prompts/code-reviewer.md}",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },

  // Last matching pattern wins. Defaults stay permissive for a solo dev; the
  // hard rules below are the ones AGENTS.md marks as NEVER.
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      // harnessc:begin read
        "*.env": "deny",
        "*.env.*": "deny"
      // harnessc:end read
    },
    "bash": {
      "*": "ask",
      "uv *": "allow",
      "npx *": "allow",
      "npm *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git stash *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "head *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "sed *": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "uniq *": "allow",
      "tr *": "allow",
      "awk *": "allow",
      "rm *": "allow",
      "true" : "allow",
      "nl *": "allow",
      "mv *": "allow",
      "stat *": "allow",
      // harnessc:begin bash
        "git commit *": "deny",
        "git push *": "deny",
        "python *": "deny",
        "python3 *": "deny",
        "pip *": "deny",
        "pip3 *": "deny",
        "pytest *": "deny"
      // harnessc:end bash
    },
    "grep *": "allow",
    "glob *": "allow",
    "list *": "allow",
    "lsp": "allow",
    "skill": "allow",
    // harnessc:begin perm
      "webfetch": "deny",
      "omt_phase": "allow",
      "omt_skip": "allow",
      "omt_complete": "allow",
      "omt_status": "allow",
      "omt_tdd": "allow",
      "omt_nav": "allow",
      "omt_think": "allow",
      "omt_kb_nav": "allow",
      "omt_q": "allow"
    // harnessc:end perm
  }
}
